# ============================================================
# CodeSentry — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file.

# ── MongoDB ──────────────────────────────────────────────────
# Provide your MongoDB Atlas connection string here.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/codesentry
MONGODB_URI=

# ── LLM Configuration ───────────────────────────────────────
# Provider: gemini | openai | anthropic
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ── Service URLs ─────────────────────────────────────────────
PYTHON_SERVICE_URL=
NEXT_PUBLIC_API_URL=

# ── Repository Storage ───────────────────────────────────────
REPO_STORAGE_PATH=

# ── Ports ────────────────────────────────────────────────────
FRONTEND_PORT=
BACKEND_PORT=
RAG_SERVICE_PORT=
