# ============================================================
# CodeSentry — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file.

# ── MongoDB ──────────────────────────────────────────────────
# Provide your MongoDB Atlas connection string here.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/codesentry
MONGODB_URI=mongodb+srv://<codesentry_app>:<codesentry_app>@<cluster-url>/codesentry

# ── LLM Configuration ───────────────────────────────────────
# Provider: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# ── Service URLs ─────────────────────────────────────────────
PYTHON_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Repository Storage ───────────────────────────────────────
REPO_STORAGE_PATH=./data/repos

# ── Ports ────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=3001
RAG_SERVICE_PORT=8000
